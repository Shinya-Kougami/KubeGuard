{
  "root": true,
  "env": {
    "node": true,
    "es2021": true,
    "jest": true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": 2021,
    "sourceType": "script"
  },
  "rules": {
    "complexity": ["warn", 5],
    "no-unused-vars": ["error", { "argsIgnorePattern": "^_|^req$|^next$" }],
    "no-console": "off",
    "eqeqeq": "error",
    "strict": ["error", "global"]
  }
}
